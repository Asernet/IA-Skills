    {
      "parameters": {
        "jsCode": "// Loop su tutti gli elementi in ingresso\nreturn items.map(item => {\n  try {\n    // Il contenuto è dentro la proprietà 'text' come stringa JSON\n    const parsedData = JSON.parse(item.json.text);\n    return {\n      json: parsedData\n    };\n  } catch (error) {\n    // Gestione errore se il parsing fallisce\n    return {\n      json: {\n        error: \"Parsing failed\",\n        original: item.json.text\n      }\n    };\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        400
      ],
      "id": "643139be-7e7c-4e01-a78e-015e61cd728e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Configurazione Stile (Palette & Design)\nconst style = {\n  bg: \"#f4f4f9\",\n  container: \"max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\",\n  header: \"background: #222222; padding: 20px; text-align: center;\",\n  headerTitle: \"color: #ffffff; margin: 0; font-size: 24px; letter-spacing: 1px;\",\n  body: \"padding: 20px;\",\n  card: \"border-bottom: 1px solid #eeeeee; padding: 15px 0; margin-bottom: 15px;\",\n  cardLast: \"border-bottom: none;\",\n  title: \"color: #2c3e50; text-decoration: none; font-size: 18px; font-weight: bold; display: block; margin-bottom: 8px;\",\n  meta: \"font-size: 12px; color: #888888; margin-bottom: 10px; display: block;\",\n  snippet: \"color: #555555; font-size: 14px; line-height: 1.6; margin-bottom: 10px;\",\n  tagContainer: \"margin-top: 8px;\",\n  tag: \"display: inline-block; background: #e0f2f1; color: #00695c; font-size: 10px; padding: 3px 8px; border-radius: 4px; margin-right: 5px; font-weight: 600;\",\n  footer: \"background: #f8f9fa; padding: 15px; text-align: center; font-size: 12px; color: #999999; border-top: 1px solid #eeeeee;\"\n};\n\n// Data odierna per l'header\nconst today = new Date().toLocaleDateString('it-IT', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\n\n// Inizio costruzione HTML\nlet html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin: 0; padding: 20px; background-color: ${style.bg};\">\n  <div style=\"${style.container}\">\n    <!-- Header -->\n    <div style=\"${style.header}\">\n      <h1 style=\"${style.headerTitle}\">AI & Tech Digest</h1>\n      <p style=\"color: #aaaaaa; font-size: 12px; margin-top: 5px;\">${today}</p>\n    </div>\n    \n    <!-- Body -->\n    <div style=\"${style.body}\">\n`;\n\n// Iterazione sugli articoli (Items provenienti dal nodo Aggregate)\nfor (const item of items) {\n  const article = item.json;\n  \n  // Skip se l'articolo è invalido o vuoto\n  if (!article.title) continue;\n\n  const dateStr = article.pubDate ? new Date(article.pubDate).toLocaleDateString('it-IT') : 'N/D';\n  \n  // Generazione Tags HTML\n  let tagsHtml = '';\n  if (article.categories && Array.isArray(article.categories)) {\n    tagsHtml = '<div style=\"' + style.tagContainer + '\">';\n    article.categories.forEach(tag => {\n      tagsHtml += `<span style=\"${style.tag}\">${tag.toUpperCase()}</span>`;\n    });\n    tagsHtml += '</div>';\n  }\n\n  // Card Articolo HTML\n  html += `\n      <div style=\"${style.card}\">\n        <a href=\"${article.link}\" target=\"_blank\" style=\"${style.title}\">${article.title}</a>\n        <span style=\"${style.meta}\">📅 ${dateStr}</span>\n        <div style=\"${style.snippet}\">${article.contentSnippet || article.content}</div>\n        ${tagsHtml}\n      </div>\n  `;\n}\n\n// Chiusura HTML\nhtml += `\n    </div>\n    \n    <!-- Footer -->\n    <div style=\"${style.footer}\">\n      <p>Generato automaticamente con n8n & Gemini</p>\n    </div>\n  </div>\n</body>\n</html>\n`;\n\n// Output finale per il prossimo nodo (Email)\nreturn {\n  json: {\n    html: html,\n    subject: `Rassegna Tech del ${today}`\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        400
      ],
      "id": "d6fb8e20-4461-4f85-909e-d5694a90951c",
      "name": "Code in JavaScript1"
